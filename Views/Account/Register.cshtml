@model test.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Workspace</title>
    <link rel="icon" type="image/jpeg" href="/img/Logo.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký - Workspace</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 0;
        }

        .auth-card {
            background: white;
            border-radius: 16px;
            padding: 40px;
            width: 100%;
            max-width: 460px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }

        .brand {
            text-align: center;
            margin-bottom: 30px;
        }

            .brand .logo {
                width: 56px;
                height: 56px;
                background: #1a1a2e;
                border-radius: 12px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-weight: bold;
                font-size: 20px;
                margin-bottom: 12px;
            }

        .form-control:focus, .form-select:focus {
            border-color: #1a1a2e;
            box-shadow: 0 0 0 0.2rem rgba(26,26,46,0.15);
        }

        .btn-primary {
            background: #1a1a2e;
            border-color: #1a1a2e;
            width: 100%;
            padding: 12px;
            font-size: 16px;
            border-radius: 8px;
        }

            .btn-primary:hover {
                background: #0f3460;
                border-color: #0f3460;
            }

        .role-card {
            border: 2px solid #dee2e6;
            border-radius: 10px;
            padding: 14px;
            cursor: pointer;
            transition: all 0.2s;
        }

            .role-card:hover {
                border-color: #1a1a2e;
            }

            .role-card.selected {
                border-color: #1a1a2e;
                background: #f0f0f8;
            }

            .role-card input {
                display: none;
            }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="brand">
            <img src="/img/Logo.jpg" alt="Workspace" style="width:56px; height:56px; border-radius:12px; object-fit:cover;" />
            <h4 style="color:#1a1a2e; font-weight:700">Workspace</h4>
            <p class="text-muted mt-1 mb-0">Tạo tài khoản mới</p>
        </div>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold"></label>
                <input asp-for="Name" class="form-control" placeholder="Nguyễn Văn A" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold"></label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <!-- Chọn Role -->
            <div class="mb-4">
                <label class="form-label fw-semibold">Vai trò của bạn</label>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="role-card d-block @(Model?.Role == "Member" ? "selected" : "")" id="card-member">
                            <input type="radio" name="Role" value="Member" checked />
                            <div class="d-flex align-items-center gap-2">
                                <span style="font-size:22px">👤</span>
                                <div>
                                    <div class="fw-semibold">Member</div>
                                    <div class="text-muted small">Thành viên nhóm</div>
                                </div>
                            </div>
                        </label>
                    </div>
                    <div class="col-6">
                        <label class="role-card d-block @(Model?.Role == "Manager" ? "selected" : "")" id="card-manager">
                            <input type="radio" name="Role" value="Manager" />
                            <div class="d-flex align-items-center gap-2">
                                <span style="font-size:22px">👑</span>
                                <div>
                                    <div class="fw-semibold">Manager</div>
                                    <div class="text-muted small">Quản lý dự án</div>
                                </div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
        </form>

        <p class="text-center text-muted mt-4 mb-0">
            Đã có tài khoản?
            <a asp-action="Login" class="text-decoration-none fw-semibold" style="color:#1a1a2e">Đăng nhập</a>
        </p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Highlight role card khi chọn
        document.querySelectorAll('.role-card input').forEach(radio => {
            radio.addEventListener('change', function () {
                document.querySelectorAll('.role-card').forEach(c => c.classList.remove('selected'));
                this.closest('.role-card').classList.add('selected');
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
