@model test.Models.Project
@{
    ViewData["Title"] = "Chat nhóm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var projectId = ViewBag.ProjectId;
    var currentUserId = ViewBag.CurrentUserId;
    var currentUserName = ViewBag.CurrentUserName;
    var groupMessages = ViewBag.GroupMessages as List<test.Models.Message> ?? new();
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/Project/Details/@Model.Id" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left"></i>
    </a>
    <h5 class="fw-bold mb-0">💬 Chat — @Model.Name</h5>
</div>

<div class="row g-3" style="height:calc(100vh - 180px)">
    <!-- Danh sách thành viên -->
    <div class="col-12 col-lg-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:14px">
            <div class="card-body p-3">
                <h6 class="fw-bold mb-3">
                    <i class="fa-solid fa-users me-1 text-primary"></i> Thành viên
                </h6>

                <!-- Group chat -->
                <a href="/Chat/Project/@Model.Id"
                   class="d-flex align-items-center gap-2 p-2 rounded mb-1 text-decoration-none bg-primary text-white">
                    <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center"
                         style="width:36px;height:36px;flex-shrink:0">
                        <i class="fa-solid fa-users" style="font-size:13px"></i>
                    </div>
                    <div>
                        <div class="fw-semibold small">Nhóm chung</div>
                        <div style="font-size:11px;opacity:0.8">Tất cả thành viên</div>
                    </div>
                </a>

                <hr class="my-2" />

                <!-- Danh sách từng thành viên -->
                @{
                    var allMembers = new List<test.Models.User>();
                    allMembers.Add(Model.Manager!);
                    foreach (var m in Model.Members)
                    {
                        if (m.UserId != Model.ManagerId) allMembers.Add(m.User);
                    }
                }
                @foreach (var member in allMembers)
                {
                    if (member.Id == currentUserId) continue;
                    <a href="/Chat/Private?projectId=@Model.Id&receiverId=@member.Id"
                       class="d-flex align-items-center gap-2 p-2 rounded mb-1 text-decoration-none text-dark"
                       style="transition:background 0.2s"
                       onmouseover="this.style.background='#f0f4ff'"
                       onmouseout="this.style.background=''">
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                             style="width:36px;height:36px;flex-shrink:0;font-size:13px">
                            @member.Name[0].ToString().ToUpper()
                        </div>
                        <div>
                            <div class="fw-semibold small">@member.Name</div>
                            <div class="text-muted" style="font-size:11px">
                                @(member.Id == Model.ManagerId ? "Manager" : "Member")
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Khung chat nhóm -->
    <div class="col-12 col-lg-9 d-flex flex-column">
        <div class="card border-0 shadow-sm flex-grow-1 d-flex flex-column" style="border-radius:14px">
            <!-- Header -->
            <div class="card-header border-0 bg-white p-3" style="border-radius:14px 14px 0 0">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                         style="width:38px;height:38px">
                        <i class="fa-solid fa-users" style="font-size:14px"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Nhóm chung</div>
                        <div class="text-muted" style="font-size:12px">@(Model.Members.Count + 1) thành viên</div>
                    </div>
                </div>
            </div>

            <!-- Messages -->
            <div class="card-body p-3 overflow-auto flex-grow-1" id="messageBox"
                 style="max-height:calc(100vh - 340px)">
                @foreach (var msg in groupMessages)
                {
                    var isMe = msg.SenderId == currentUserId;
                    <div class="d-flex @(isMe ? "justify-content-end" : "justify-content-start") mb-2">
                        <div style="max-width:70%">
                            @if (!isMe)
                            {
                                <div class="text-muted mb-1" style="font-size:11px">@msg.Sender.Name</div>
                            }
                            <div class="px-3 py-2 rounded-3 @(isMe ? "bg-primary text-white" : "bg-light text-dark")"
                                 style="font-size:14px">
                                @msg.Content
                            </div>
                            <div class="text-muted mt-1 @(isMe ? "text-end" : "")" style="font-size:10px">
                                @msg.SentAt.ToString("HH:mm dd/MM")
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Input -->
            <div class="card-footer border-0 bg-white p-3" style="border-radius:0 0 14px 14px">
                <div class="d-flex gap-2">
                    <input type="text" id="messageInput" class="form-control"
                           placeholder="Nhập tin nhắn..." autocomplete="off" />
                    <button class="btn btn-primary px-3" onclick="sendMessage()">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .build();

        connection.on("ReceiveGroupMessage", (msg) => {
            const isMe = msg.senderId == @currentUserId;
            const html = `
                <div class="d-flex ${isMe ? 'justify-content-end' : 'justify-content-start'} mb-2">
                    <div style="max-width:70%">
                        ${!isMe ? `<div class="text-muted mb-1" style="font-size:11px">${msg.senderName}</div>` : ''}
                        <div class="px-3 py-2 rounded-3 ${isMe ? 'bg-primary text-white' : 'bg-light text-dark'}" style="font-size:14px">
                            ${msg.content}
                        </div>
                        <div class="text-muted mt-1 ${isMe ? 'text-end' : ''}" style="font-size:10px">${msg.sentAt}</div>
                    </div>
                </div>`;
            document.getElementById('messageBox').insertAdjacentHTML('beforeend', html);
            scrollToBottom();
        });

        connection.start().then(() => {
            connection.invoke("JoinProject", "@projectId.ToString()");
        });

        function sendMessage() {
            const input = document.getElementById('messageInput');
            const content = input.value.trim();
            if (!content) return;
            connection.invoke("SendGroupMessage", @projectId, @currentUserId, "@currentUserName", content);
            input.value = '';
        }

        document.getElementById('messageInput').addEventListener('keypress', e => {
            if (e.key === 'Enter') sendMessage();
        });

        function scrollToBottom() {
            const box = document.getElementById('messageBox');
            box.scrollTop = box.scrollHeight;
        }

        scrollToBottom();
    </script>
}
