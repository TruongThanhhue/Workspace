@model test.Models.Project
@{
    ViewData["Title"] = "Yêu cầu tham gia";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var pending = Model.JoinRequests.Where(j => j.Status == "Pending").ToList();
    var others = Model.JoinRequests.Where(j => j.Status != "Pending").ToList();
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/Project/Details/@Model.Id" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left"></i>
    </a>
    <h4 class="fw-bold mb-0">👥 Yêu cầu tham gia — @Model.Name</h4>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4" style="border-radius:14px">
    <div class="card-body p-4">
        <h6 class="fw-bold mb-3">
            Đang chờ duyệt
            <span class="badge bg-warning text-dark ms-1">@pending.Count</span>
        </h6>

        @if (!pending.Any())
        {
            <div class="text-center text-muted py-4">
                <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                Không có yêu cầu nào đang chờ
            </div>
        }
        else
        {
            @foreach (var req in pending)
            {
                <div class="d-flex align-items-center justify-content-between py-3 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                             style="width:40px;height:40px;font-size:15px;flex-shrink:0">
                            @req.User.Name[0].ToString().ToUpper()
                        </div>
                        <div>
                            <div class="fw-semibold">@req.User.Name</div>
                            <div class="text-muted small">@req.User.Email</div>
                            <div class="text-muted" style="font-size:11px">
                                @req.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <form asp-action="ApproveRequest" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" value="@req.Id" />
                            <input type="hidden" name="action" value="approve" />
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="fa-solid fa-check me-1"></i> Duyệt
                            </button>
                        </form>
                        <form asp-action="ApproveRequest" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" value="@req.Id" />
                            <input type="hidden" name="action" value="reject" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="fa-solid fa-xmark me-1"></i> Từ chối
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (others.Any())
{
    <div class="card border-0 shadow-sm" style="border-radius:14px">
        <div class="card-body p-4">
            <h6 class="fw-bold mb-3 text-muted">Đã xử lý</h6>
            @foreach (var req in others)
            {
                <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                             style="width:36px;height:36px;font-size:13px;flex-shrink:0">
                            @req.User.Name[0].ToString().ToUpper()
                        </div>
                        <div>
                            <div class="fw-semibold small">@req.User.Name</div>
                            <div class="text-muted" style="font-size:11px">@req.User.Email</div>
                        </div>
                    </div>
                    <span class="badge @(req.Status == "Approved" ? "bg-success" : "bg-danger")">
                        @(req.Status == "Approved" ? "Đã duyệt" : "Đã từ chối")
                    </span>
                </div>
            }
        </div>
    </div>
}
