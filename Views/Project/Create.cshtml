@model test.Models.ProjectViewModel
@{
    ViewData["Title"] = "Tạo dự án";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a href="/Project/Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-left"></i>
    </a>
    <h4 class="fw-bold mb-0"> Tạo dự án mới</h4>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm" style="border-radius:14px">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"
                         style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Tên dự án</label>
                        <input asp-for="Name" class="form-control" placeholder="VD: Website bán hàng" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Mô tả ngắn về dự án..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ảnh dự án</label>
                        <input type="file" name="ImageFile" class="form-control" accept="image/*"
                               onchange="previewImage(this)" />
                        <div class="mt-2" id="preview-box" style="display:none">
                            <img id="preview-img" src="" alt="Preview"
                                 style="width:80px;height:80px;border-radius:10px;object-fit:cover;" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label asp-for="StartDate" class="form-label fw-semibold">Ngày bắt đầu</label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="EndDate" class="form-label fw-semibold">Ngày kết thúc</label>
                            <input asp-for="EndDate" class="form-control" type="date" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark px-4">
                            <i class="fa-solid fa-check me-1"></i> Tạo dự án
                        </button>
                        <a href="/Project/Index" class="btn btn-outline-secondary px-4">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    document.getElementById('preview-img').src = e.target.result;
                    document.getElementById('preview-box').style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
