@model List<test.Models.TaskItem>
@{
    ViewData["Title"] = "Nhiệm vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    test.Models.Project? project = null;
    try { project = ViewBag.Project as test.Models.Project; } catch { }
    bool isManager = ViewBag.IsManager == true;
}

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
    .tk-wrap { font-family: 'DM Sans', 'Segoe UI', sans-serif; }

    .tk-header {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 20px; padding-bottom: 18px; border-bottom: 1px solid #f1f5f9;
    }
    .tk-header-left { display: flex; align-items: center; gap: 10px; }
    .tk-title { font-size: 20px; font-weight: 700; color: #0f172a; letter-spacing: -0.3px; margin: 0; }

    .btn-back {
        width: 32px; height: 32px; border-radius: 8px; border: 1.5px solid #e2e8f0;
        background: #fff; display: flex; align-items: center; justify-content: center;
        color: #475569; text-decoration: none; transition: all .15s; font-size: 13px;
    }
    .btn-back:hover { background: #f8fafc; border-color: #cbd5e1; color: #0f172a; }

    .btn-create {
        display: inline-flex; align-items: center; gap: 6px;
        background: #0f172a; color: #fff; border: none; border-radius: 9px;
        padding: 8px 16px; font-size: 12px; font-weight: 600; text-decoration: none;
        transition: background .15s; font-family: inherit;
    }
    .btn-create:hover { background: #1e293b; color: #fff; }

    /* Filter tabs */
    .tk-filters { display: flex; gap: 6px; margin-bottom: 16px; flex-wrap: wrap; }
    .tk-filter {
        font-size: 12px; font-weight: 600; padding: 6px 14px; border-radius: 8px;
        border: 1.5px solid #e2e8f0; background: #fff; color: #64748b;
        cursor: pointer; transition: all .15s; font-family: inherit;
    }
    .tk-filter:hover { border-color: #cbd5e1; color: #0f172a; background: #f8fafc; }
    .tk-filter.active { background: #0f172a; color: #fff; border-color: #0f172a; }

    /* Table card */
    .tk-card {
        background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden;
    }

    .tk-table { width: 100%; border-collapse: collapse; }
    .tk-table thead tr {
        background: #f8fafc; border-bottom: 1px solid #e2e8f0;
    }
    .tk-table thead th {
        padding: 11px 14px; font-size: 11px; font-weight: 700; color: #64748b;
        text-transform: uppercase; letter-spacing: 0.4px; white-space: nowrap;
    }
    .tk-table thead th:first-child { padding-left: 20px; }

    .tk-table tbody tr {
        border-bottom: 1px solid #f8fafc; cursor: pointer; transition: background .1s;
    }
    .tk-table tbody tr:last-child { border-bottom: none; }
    .tk-table tbody tr:hover { background: #fafafa; }

    .tk-table td { padding: 12px 14px; font-size: 13px; vertical-align: middle; }
    .tk-table td:first-child { padding-left: 20px; }

    .tk-task-name { font-weight: 600; color: #0f172a; text-decoration: none; display: block; }
    .tk-task-name:hover { color: #0f172a; }
    .tk-task-proj { font-size: 11px; color: #94a3b8; margin-top: 2px; }

    .avatar {
        width: 28px; height: 28px; border-radius: 7px; background: #0f172a;
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 11px; font-weight: 700; flex-shrink: 0;
    }

    .priority-badge { font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 20px; }
    .p-high   { background: #fef2f2; color: #dc2626; }
    .p-medium { background: #fffbeb; color: #b45309; }
    .p-low    { background: #f0fdf4; color: #16a34a; }

    .status-badge { font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 20px; }
    .s-done    { background: #f0fdf4; color: #16a34a; }
    .s-overdue { background: #fef2f2; color: #dc2626; }
    .s-pending { background: #f8fafc; color: #94a3b8; }

    .deadline-text { font-size: 12px; font-weight: 600; }
    .deadline-ok   { color: #64748b; }
    .deadline-late { color: #dc2626; }

    .btn-submit {
        font-size: 11px; font-weight: 700; padding: 5px 12px; border-radius: 7px;
        background: #0f172a; color: #fff; border: none; cursor: pointer; font-family: inherit;
        transition: background .15s;
    }
    .btn-submit:hover { background: #1e293b; }

    .btn-action {
        width: 28px; height: 28px; border-radius: 7px; border: 1.5px solid #e2e8f0;
        background: #fff; display: inline-flex; align-items: center; justify-content: center;
        color: #475569; text-decoration: none; font-size: 11px; transition: all .15s; cursor: pointer;
        font-family: inherit;
    }
    .btn-action:hover { background: #f8fafc; border-color: #cbd5e1; color: #0f172a; }
    .btn-action.danger:hover { background: #fef2f2; border-color: #fecaca; color: #dc2626; }

    /* Empty */
    .tk-empty {
        padding: 60px 20px; text-align: center; color: #94a3b8;
    }
    .tk-empty i { font-size: 28px; margin-bottom: 10px; display: block; opacity: .3; }
    .tk-empty p { font-size: 13px; }

    /* Modal */
    .sub-modal .modal-content {
        border: none; border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        font-family: 'DM Sans', sans-serif;
    }
    .sub-modal .modal-header { padding: 20px 24px 0; border: none; }
    .sub-modal .modal-body { padding: 16px 24px 24px; }
    .sub-modal .modal-title { font-size: 15px; font-weight: 700; color: #0f172a; }
    .sub-input {
        width: 100%; border: 1.5px solid #e2e8f0; border-radius: 9px;
        padding: 8px 12px; font-size: 13px; font-family: inherit; outline: none;
        transition: border-color .15s; box-sizing: border-box;
    }
    .sub-input:focus { border-color: #0f172a; }
    .sub-label { font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 6px; display: block; }
</style>

<div class="tk-wrap">
    <!-- Header -->
    <div class="tk-header">
      <div class="tk-header-left">
            <!--<a href="@(project != null ? $"/Project/Details/{project.Id}" : "/Project/Index")" class="btn-back">
                <i class="fa-solid fa-arrow-left"></i>
            </a> -->
            <div class="tk-title">
                @(project == null ? "Nhiệm vụ của tôi" : $"Nhiệm vụ — {project.Name}")
            </div>
        </div>
        @if (project != null && isManager)
        {
            <a href="/Task/Create?projectId=@project.Id" class="btn-create">
                <i class="fa-solid fa-plus" style="font-size:10px"></i> Tạo nhiệm vụ
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 mb-3" style="border-radius:10px;font-size:13px">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show py-2 mb-3" style="border-radius:10px;font-size:13px">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters -->
    <div class="tk-filters">
        <button class="tk-filter active" data-filter="all">
            Tất cả <span style="opacity:.6">(@Model.Count)</span>
        </button>
        <button class="tk-filter" data-filter="Done">
            Hoàn thành <span style="opacity:.6">(@Model.Count(t => t.Status == "Done"))</span>
        </button>
        <button class="tk-filter" data-filter="Overdue">
            Quá hạn <span style="opacity:.6">(@Model.Count(t => t.Status == "Overdue"))</span>
        </button>
    </div>

    <!-- Table -->
    @if (!Model.Any())
    {
        <div class="tk-card">
            <div class="tk-empty">
                <i class="fa-regular fa-clipboard"></i>
                <p>Chưa có nhiệm vụ nào</p>
            </div>
        </div>
    }
    else
    {
        <div class="tk-card">
            <div style="overflow-x:auto">
                <table class="tk-table">
                    <thead>
                        <tr>
                            <th>Nhiệm vụ</th>
                            <th>Người thực hiện</th>
                            <th>Ưu tiên</th>
                            <th>Trạng thái</th>
                            <th>Deadline</th>
                            <th></th>
                            @if (isManager) { <th>Thao tác</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model)
                        {
                            var priorityClass = task.Priority switch { "High" => "p-high", "Medium" => "p-medium", _ => "p-low" };
                            var priorityLabel = task.Priority switch { "High" => "Cao", "Medium" => "Trung bình", _ => "Thấp" };
                            var statusClass = task.Status switch { "Done" => "s-done", "Overdue" => "s-overdue", _ => "s-pending" };
                            var statusLabel = task.Status switch { "Done" => "Hoàn thành", "Overdue" => "Quá hạn", _ => "" };
                            var deadlineClass = task.EndDate < DateTime.Now && task.Status != "Done" ? "deadline-late" : "deadline-ok";

                            <tr class="task-row" data-status="@task.Status"
                                onclick="window.location='/Task/Details/@task.Id'">
                                <td>
                                    <div class="tk-task-name">@task.Title</div>
                                    @if (project == null && task.Project != null)
                                    {
                                        <div class="tk-task-proj">@task.Project.Name</div>
                                    }
                                </td>
                                <td>
                                    @if (task.AssignedUser != null)
                                    {
                                        <div style="display:flex;align-items:center;gap:8px">
                                            <div class="avatar">@task.AssignedUser.Name[0].ToString().ToUpper()</div>
                                            <span style="font-size:12px;font-weight:500;color:#475569">@task.AssignedUser.Name</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="font-size:12px;color:#cbd5e1">Chưa giao</span>
                                    }
                                </td>
                                <td>
                                    <span class="priority-badge @priorityClass">@priorityLabel</span>
                                </td>
                                <td>
                                    @if (isManager)
                                    {
                                        @if (task.Status == "Done")
                                        {
                                            <span class="status-badge s-done">Đã nộp</span>
                                        }
                                    }
                                    else if (!string.IsNullOrEmpty(statusLabel))
                                    {
                                        <span class="status-badge @statusClass">@statusLabel</span>
                                    }
                                </td>
                                <td>
                                    <span class="deadline-text @deadlineClass">
                                        @task.EndDate.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td onclick="event.stopPropagation()">
                                    @if (task.AssignedTo == Context.Session.GetInt32("UserId") && task.Status != "Done")
                                    {
                                        <button class="btn-submit" onclick="openSubmitModal(@task.Id)">
                                            <i class="fa-solid fa-upload me-1"></i>Nộp
                                        </button>
                                    }
                                </td>
                                @if (isManager)
                                {
                                    <td onclick="event.stopPropagation()">
                                        <div style="display:flex;gap:6px">
                                            <a href="/Task/Details/@task.Id" class="btn-action">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            <a href="/Task/Edit/@task.Id" class="btn-action">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@task.Id" method="post" style="margin:0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action danger"
                                                        onclick="return confirm('Xóa nhiệm vụ này?')">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Submit Modal -->
<div class="modal fade sub-modal" id="submitModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title">Nộp nhiệm vụ</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="submitForm" asp-controller="Submission" asp-action="Submit"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskId" id="modalTaskId" />

                    <div class="mb-3">
                        <label class="sub-label"><i class="fa-solid fa-paperclip me-1"></i>Tải file lên</label>
                        <input type="file" name="file" class="sub-input" style="padding:6px 10px" />
                    </div>
                    <div class="mb-3">
                        <label class="sub-label"><i class="fa-solid fa-link me-1"></i>Link (GitHub, Drive...)</label>
                        <input type="text" name="linkUrl" class="sub-input" placeholder="https://..." />
                    </div>
                    <div class="mb-4">
                        <label class="sub-label"><i class="fa-solid fa-pen-to-square me-1"></i>Ghi chú</label>
                        <textarea name="note" class="sub-input" rows="3"
                                  placeholder="Mô tả những gì đã làm..." style="resize:none"></textarea>
                    </div>

                    <div style="display:flex;gap:8px;justify-content:flex-end">
                        <button type="button" data-bs-dismiss="modal"
                                style="font-size:13px;font-weight:600;padding:8px 16px;border-radius:8px;border:1.5px solid #e2e8f0;background:#fff;color:#475569;cursor:pointer;font-family:inherit">
                            Hủy
                        </button>
                        <button type="submit"
                                style="font-size:13px;font-weight:600;padding:8px 20px;border-radius:8px;border:none;background:#0f172a;color:#fff;cursor:pointer;font-family:inherit">
                            <i class="fa-solid fa-paper-plane me-1"></i>Nộp
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openSubmitModal(taskId) {
    document.getElementById('modalTaskId').value = taskId;
    new bootstrap.Modal(document.getElementById('submitModal')).show();
}

document.querySelectorAll('.tk-filter').forEach(btn => {
    btn.addEventListener('click', function () {
        document.querySelectorAll('.tk-filter').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        const filter = this.dataset.filter;
        document.querySelectorAll('.task-row').forEach(row => {
            row.style.display = filter === 'all' || row.dataset.status === filter ? '' : 'none';
        });
    });
});
</script>
}
