@model List<test.Models.Project>
@{
    ViewData["Title"] = "Quản lý nhiệm vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .mt-wrap {
        font-family: 'DM Sans', 'Segoe UI', sans-serif;
    }

    .mt-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        padding-bottom: 18px;
        border-bottom: 1px solid #f1f5f9;
    }

    .mt-title {
        font-size: 20px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.3px;
        margin: 0;
    }

    .mt-sub {
        font-size: 13px;
        color: #94a3b8;
        margin-top: 3px;
    }

    .mt-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 16px;
    }

    @@media(max-width:1100px) {
        .mt-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media(max-width:640px) {
        .mt-grid {
            grid-template-columns: 1fr;
        }
    }

    .mt-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        transition: box-shadow .2s, transform .2s;
    }

        .mt-card:hover {
            box-shadow: 0 6px 24px rgba(0,0,0,0.08);
            transform: translateY(-2px);
        }

    .mt-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .mt-name {
        font-size: 14px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 3px;
    }

    .mt-desc {
        font-size: 12px;
        color: #94a3b8;
        line-height: 1.5;
    }

    .mt-stats {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 8px;
    }

    .mt-stat {
        background: #f8fafc;
        border-radius: 9px;
        padding: 10px 8px;
        text-align: center;
    }

    .mt-stat-n {
        font-size: 20px;
        font-weight: 700;
        color: #0f172a;
        line-height: 1;
    }

    .mt-stat-l {
        font-size: 10px;
        color: #94a3b8;
        font-weight: 500;
        margin-top: 3px;
    }

    .mt-prog-lbl {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: #94a3b8;
        font-weight: 500;
        margin-bottom: 5px;
    }

    .mt-prog-track {
        height: 5px;
        background: #f1f5f9;
        border-radius: 10px;
        overflow: hidden;
    }

    .mt-prog-fill {
        height: 100%;
        border-radius: 10px;
        background: #0f172a;
    }

        .mt-prog-fill.green {
            background: #22c55e;
        }

    .mt-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: #0f172a;
        color: #fff;
        border: none;
        border-radius: 9px;
        padding: 9px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: background .15s;
        font-family: inherit;
        margin-top: auto;
    }

        .mt-btn:hover {
            background: #1e293b;
            color: #fff;
        }

    .mt-empty {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 60px 20px;
        text-align: center;
        color: #94a3b8;
    }

        .mt-empty i {
            font-size: 30px;
            margin-bottom: 12px;
            display: block;
            opacity: .35;
        }
</style>

<div class="mt-wrap">
    <div class="mt-header">
        <div>
            <div class="mt-title">Quản lý nhiệm vụ</div>
            <div class="mt-sub">@Model.Count dự án đang quản lý</div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="mt-empty">
            <i class="fa-regular fa-clipboard"></i>
            <p style="font-size:13px">Bạn chưa quản lý dự án nào</p>
        </div>
    }
    else
    {
        <div class="mt-grid">
            @foreach (var project in Model)
            {
                var total = project.Tasks.Count;
                var done = project.Tasks.Count(t => t.Status == "Done");
                var pending = project.Tasks.Count(t => t.Status == "Pending");
                var overdue = project.Tasks.Count(t => t.Status == "Overdue");
                var percent = total > 0 ? (int)((double)done / total * 100) : 0;

                <div class="mt-card">
                    <div class="mt-card-top">
                        <div style="flex:1;min-width:0">
                            <div class="mt-name">@project.Name</div>
                            @if (!string.IsNullOrEmpty(project.Description))
                            {
                                <div class="mt-desc">
                                    @(project.Description.Length > 60 ? project.Description[..60] + "..." : project.Description)
                                </div>
                            }
                        </div>
                        @if (overdue > 0)
                        {
                            <span style="font-size:11px;font-weight:700;padding:4px 10px;border-radius:20px;background:#fef2f2;color:#dc2626;white-space:nowrap;margin-left:10px">
                                @overdue quá hạn
                            </span>
                        }
                    </div>

                    <div class="mt-stats">
                        <div class="mt-stat">
                            <div class="mt-stat-n">@total</div>
                            <div class="mt-stat-l">Tổng</div>
                        </div>
                        <div class="mt-stat">
                            <div class="mt-stat-n" style="color:#22c55e">@done</div>
                            <div class="mt-stat-l">Hoàn thành</div>
                        </div>
                        <div class="mt-stat">
                            <div class="mt-stat-n" style="color:#f59e0b">@pending</div>
                            <div class="mt-stat-l">Chờ xử lý</div>
                        </div>
                    </div>

                    <div>
                        <div class="mt-prog-lbl">
                            <span>Tiến độ</span><span>@percent%</span>
                        </div>
                        <div class="mt-prog-track">
                            <div class="mt-prog-fill @(percent == 100 ? "green" : "")" style="width:@percent%"></div>
                        </div>
                    </div>

                    <a href="/Task/Index?projectId=@project.Id" class="mt-btn">
                        <i class="fa-solid fa-list-check"></i> Quản lý nhiệm vụ
                    </a>
                </div>
            }
        </div>
    }
</div>
